import org.springframework.web.bind.annotation.*;
import java.util.List;

@RestController
@RequestMapping("/produtos")
public class ProdutoController {

    private final ProdutoRepository repo;
    private final ScraperService scraper;
    private final IAService ia;

    public ProdutoController(ProdutoRepository repo, ScraperService scraper, IAService ia) {
        this.repo = repo;
        this.scraper = scraper;
        this.ia = ia;
    }

    @PostMapping
    public Produto adicionar(@RequestBody Produto produto) {
        double preco = scraper.buscarPreco(produto.getLink());
        if (preco > 0) {
            produto.setPreco(preco);
        }
        return repo.save(produto);
    }

    @GetMapping
    public List<Produto> listar() {
        return repo.findAll();
    }

    @GetMapping("/recomendar")
    public Produto recomendar(@RequestParam String nome) {
        return ia.recomendarMaisBarato(repo.findAll(), nome);
    }
}
